# Copy to src/backend/.env (gitignored) and set a key.
# No file is needed when AI_PROVIDER=mock.

# mock | openai | anthropic | xai
# Leave unset to auto-pick: the first provider with a key below, otherwise mock.
# AI_PROVIDER=mock

# Override the provider's default model (gpt-4o-mini | claude-3-5-haiku-latest | grok-4.7).
# AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Server port (the Vite dev server proxies /api here).
PORT=8787

# Provider request timeout, milliseconds.
AI_TIMEOUT_MS=25000

# Max tokens per generated response.
AI_MAX_TOKENS=400
